{
  "name": "garmin-activities-mcp",
  "version": "1.0.0",
  "description": "MCP de atividades Garmin com retorno limitado a métricas de treino, sem localização ou identificação.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
